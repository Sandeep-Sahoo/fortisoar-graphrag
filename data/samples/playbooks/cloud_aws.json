        {
          "@type": "Workflow",
          "uuid": "36b55133-8ea8-55f6-b28f-abf6fdbbda91",
          "name": "AWS - Public S3 Bucket Remediation",
          "description": "Re-enables S3 public access block on unexpectedly public buckets (except allow-listed website buckets) and tickets the owner.",
          "isActive": true,
          "recordTags": [
            "AWS",
            "S3"
          ],
          "triggerStep": "/api/3/workflow_steps/41439e42-23a7-5bd6-be94-f5cd14cd7e32",
          "steps": [
            {
              "@type": "WorkflowStep",
              "uuid": "41439e42-23a7-5bd6-be94-f5cd14cd7e32",
              "name": "Start",
              "arguments": {
                "resource": "alerts",
                "resources": [
                  "alerts"
                ],
                "fieldbasedtrigger": {
                  "filters": [
                    {
                      "field": "type",
                      "value": "S3 Public Access"
                    }
                  ]
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "cf06cf04-7271-5c61-820c-89ffd3a2a219",
              "name": "Allow-Listed Bucket?",
              "arguments": {
                "conditions": [
                  {
                    "option": "Allowed",
                    "condition": "{{vars.input.records[0].bucket in ['customer-portal-static']}}"
                  }
                ]
              },
              "stepType": {
                "name": "Decision"
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "06ab38d9-4f24-5e61-b136-f320786eee19",
              "name": "Get Bucket Policy",
              "arguments": {
                "connector": "aws-s3",
                "operation": "get_bucket_policy",
                "version": "1.3.0",
                "params": {
                  "bucket": "{{vars.input.records[0].bucket}}"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "4524a2e8-36f8-56a8-b63d-9dd32061635e",
              "name": "Enable Public Access Block",
              "arguments": {
                "connector": "aws-s3",
                "operation": "put_public_access_block",
                "version": "1.3.0",
                "params": {
                  "bucket": "{{vars.input.records[0].bucket}}"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "875a1935-3854-5f4c-a792-1b5a4380e159",
              "name": "Mark Remediated",
              "arguments": {
                "status": "Remediated"
              },
              "stepType": {
                "name": "Update Record"
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "8009632c-2dcc-55b8-8e77-14d310466829",
              "name": "Ticket Bucket Owner",
              "arguments": {
                "workflowReference": "/api/3/workflows/60f0b79e-65c1-5934-ab18-7b3c7218bdb5",
                "arguments": {
                  "records": "{{vars.input.records}}"
                }
              }
            }
          ],
          "routes": [
            {
              "sourceStep": "/api/3/workflow_steps/41439e42-23a7-5bd6-be94-f5cd14cd7e32",
              "targetStep": "/api/3/workflow_steps/cf06cf04-7271-5c61-820c-89ffd3a2a219"
            },
