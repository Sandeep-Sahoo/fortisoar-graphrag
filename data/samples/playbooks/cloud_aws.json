              "uuid": "4042c894-17a3-548d-a1b7-99d4d3618193",
              "name": "Restart Logging",
              "arguments": {
                "connector": "aws-cloudtrail",
                "operation": "start_logging",
                "version": "1.2.0",
                "params": {
                  "trail": "org-trail",
                  "aws_access_key_id": "AKIAIOSFODNN7EXAMPLE",
                  "aws_secret_access_key": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "90517734-e09b-53e6-aa99-228fc19c5788",
