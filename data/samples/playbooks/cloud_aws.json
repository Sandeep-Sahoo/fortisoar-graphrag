{
  "type": "workflow_collections",
  "data": [
    {
      "@type": "WorkflowCollection",
      "name": "SOC - Cloud AWS",
      "description": "AWS threat detection and response",
      "workflows": [
        {
          "@type": "Workflow",
          "uuid": "f1e35535-dcae-590f-8ad3-480ceece873d",
          "name": "AWS GuardDuty Finding Triage",
          "description": "Enriches GuardDuty findings and routes credential compromise to key disablement and instance compromise to EC2 isolation.",
          "isActive": true,
          "recordTags": [
            "AWS",
            "GuardDuty"
          ],
          "triggerStep": "/api/3/workflow_steps/064f1277-48e6-5964-89bc-db84f2e0a55c",
          "steps": [
            {
              "@type": "WorkflowStep",
              "uuid": "064f1277-48e6-5964-89bc-db84f2e0a55c",
              "name": "Start",
              "arguments": {
                "resource": "alerts",
                "resources": [
                  "alerts"
                ],
                "fieldbasedtrigger": {
                  "filters": [
                    {
                      "field": "source",
                      "value": "AWS GuardDuty"
                    }
                  ]
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "8aa16e2c-1d28-5316-ab59-9fadad1e06b9",
              "name": "Get Finding Details",
              "arguments": {
                "connector": "aws-guardduty",
                "operation": "get_findings",
                "version": "1.1.0",
                "params": {
                  "finding_ids": [
                    "{{vars.input.records[0].sourceId}}"
                  ]
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "259a0a95-4e2b-5bc0-8880-46852edae5a2",
              "name": "High Severity?",
              "arguments": {
                "conditions": [
                  {
                    "option": "High",
                    "condition": "{{vars.steps.Get_Finding_Details.data.severity >= 7}}"
                  }
                ]
              },
              "stepType": {
                "name": "Decision"
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "77f27f22-28c8-5f27-a7f2-039da0dd388b",
              "name": "Finding Type?",
              "arguments": {
                "conditions": [
                  {
                    "option": "Credentials",
                    "condition": "{{'IAMUser' in vars.steps.Get_Finding_Details.data.type}}"
                  },
                  {
                    "option": "Instance",
                    "condition": "{{'EC2' in vars.steps.Get_Finding_Details.data.type}}"
                  }
                ]
              },
              "stepType": {
                "name": "Decision"
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "c1392e26-d912-53f1-9a35-eb225430c608",
              "name": "Disable Leaked Key",
              "arguments": {
                "workflowReference": "/api/3/workflows/c22ee81e-4232-5bdc-9c23-a5ac741e6a1b",
                "arguments": {
                  "records": "{{vars.input.records}}"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "caf1972b-5804-51f8-b4ea-59779c29686a",
              "name": "Isolate Instance",
              "arguments": {
                "workflowReference": "/api/3/workflows/6d0f92e4-488f-5661-9e2c-67aba7947a0f",
                "arguments": {
                  "records": "{{vars.input.records}}"
                }
              }
            }
          ],
          "routes": [
            {
              "sourceStep": "/api/3/workflow_steps/064f1277-48e6-5964-89bc-db84f2e0a55c",
              "targetStep": "/api/3/workflow_steps/8aa16e2c-1d28-5316-ab59-9fadad1e06b9"
            },
            {
              "sourceStep": "/api/3/workflow_steps/8aa16e2c-1d28-5316-ab59-9fadad1e06b9",
              "targetStep": "/api/3/workflow_steps/259a0a95-4e2b-5bc0-8880-46852edae5a2"
            },
            {
              "sourceStep": "/api/3/workflow_steps/259a0a95-4e2b-5bc0-8880-46852edae5a2",
              "targetStep": "/api/3/workflow_steps/77f27f22-28c8-5f27-a7f2-039da0dd388b",
              "label": "High"
            },
            {
              "sourceStep": "/api/3/workflow_steps/77f27f22-28c8-5f27-a7f2-039da0dd388b",
              "targetStep": "/api/3/workflow_steps/c1392e26-d912-53f1-9a35-eb225430c608",
              "label": "Credentials"
            },
            {
              "sourceStep": "/api/3/workflow_steps/c1392e26-d912-53f1-9a35-eb225430c608",
              "targetStep": "/api/3/workflow_steps/caf1972b-5804-51f8-b4ea-59779c29686a"
            }
          ]
        },
        {
          "@type": "Workflow",
          "uuid": "6d0f92e4-488f-5661-9e2c-67aba7947a0f",
          "name": "AWS - Isolate EC2 Instance",
          "description": "Snapshots all volumes for forensics, swaps the instance into the quarantine security group and tags it, after approval for production.",
          "isActive": true,
          "recordTags": [
            "AWS",
            "EC2",
            "Containment",
            "Subroutine"
          ],
          "triggerStep": "/api/3/workflow_steps/713590a1-9d99-5c85-bf76-923cd0d18f95",
          "steps": [
            {
              "@type": "WorkflowStep",
              "uuid": "713590a1-9d99-5c85-bf76-923cd0d18f95",
              "name": "Start",
              "arguments": {
                "step_variables": {
                  "input": {
                    "records": "{{vars.input.records}}"
                  }
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "28b2ac3c-329a-546b-9272-a187e2ddbdc2",
              "name": "Approve Isolation",
              "arguments": {
                "title": "Isolate {{vars.input.records[0].instanceId}}?",
                "owner": "Cloud On-Call"
              },
              "stepType": {
                "name": "Manual Input"
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "a9910f66-8f10-5042-8d3e-b889094ad30d",
              "name": "Describe Instance",
              "arguments": {
                "connector": "aws-ec2",
                "operation": "describe_instance",
                "version": "2.0.0",
                "params": {
                  "instance_id": "{{vars.input.records[0].instanceId}}"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "54ca6a86-8b49-567b-b8af-04334c0e6a00",
              "name": "Snapshot Volumes",
              "arguments": {
                "connector": "aws-ec2",
                "operation": "create_snapshot",
                "version": "2.0.0",
                "params": {
                  "volume_ids": "{{vars.steps.Describe_Instance.data.volumes}}"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "120ec8b2-1845-5c54-b5cd-b7b942a491b2",
              "name": "Apply Quarantine Security Group",
              "arguments": {
                "connector": "aws-ec2",
                "operation": "modify_instance_security_groups",
                "version": "2.0.0",
                "params": {
                  "instance_id": "{{vars.input.records[0].instanceId}}",
                  "groups": [
                    "sg-quarantine"
                  ]
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "d218d939-6cde-5448-a8b8-91dde8c2e2fe",
              "name": "Tag Instance",
              "arguments": {
                "connector": "aws-ec2",
                "operation": "tag_instance",
                "version": "2.0.0",
                "params": {
                  "tags": {
                    "SecurityStatus": "Quarantined"
                  }
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "02706363-af2f-5183-9da3-d2c6edc20bcc",
              "name": "Notify On-Call",
              "arguments": {
                "workflowReference": "/api/3/workflows/4cf2d919-9337-513b-b3a1-f77e28d3bb86",
                "arguments": {
                  "records": "{{vars.input.records}}"
                }
              }
            }
          ],
          "routes": [
            {
              "sourceStep": "/api/3/workflow_steps/713590a1-9d99-5c85-bf76-923cd0d18f95",
              "targetStep": "/api/3/workflow_steps/28b2ac3c-329a-546b-9272-a187e2ddbdc2"
            },
            {
              "sourceStep": "/api/3/workflow_steps/28b2ac3c-329a-546b-9272-a187e2ddbdc2",
              "targetStep": "/api/3/workflow_steps/a9910f66-8f10-5042-8d3e-b889094ad30d"
