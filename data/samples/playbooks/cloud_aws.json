        {
          "@type": "Workflow",
          "uuid": "ed574e63-ffef-5f8f-b375-3acb42f69e27",
          "name": "AWS - Root Account Usage Alert",
          "description": "Looks up root sign-in events and pages on-call unless the account owner confirms the login within 15 minutes.",
          "isActive": true,
          "recordTags": [
            "AWS",
            "IAM"
          ],
          "triggerStep": "/api/3/workflow_steps/468e949b-614e-5227-9c35-b31d4e083f94",
          "steps": [
            {
              "@type": "WorkflowStep",
              "uuid": "468e949b-614e-5227-9c35-b31d4e083f94",
              "name": "Start",
              "arguments": {
                "resource": "alerts",
                "resources": [
                  "alerts"
                ],
                "fieldbasedtrigger": {
                  "filters": [
                    {
                      "field": "type",
                      "value": "Root Login"
                    }
                  ]
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "6659b6ed-7c33-5ce5-abce-39834f3a7538",
              "name": "Lookup Root Sign-ins",
              "arguments": {
                "connector": "aws-cloudtrail",
                "operation": "lookup_events",
                "version": "1.2.0",
                "params": {
                  "event_name": "ConsoleLogin",
                  "user_name": "root"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "43e49140-be13-54ef-9c48-0aed9494fadb",
              "name": "Owner Confirms Login",
              "arguments": {
                "title": "Did you sign in as root to {{vars.input.records[0].accountName}}?",
                "owner": "Account Owner",
                "timeout_hours": 0.25
              },
              "stepType": {
                "name": "Manual Input"
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "eb049cc7-cbc9-5736-ac17-1e33b7a7fb7a",
              "name": "Confirmed?",
              "arguments": {
                "conditions": [
                  {
                    "option": "Not confirmed",
                    "condition": "{{vars.steps.Owner_Confirms_Login.input.answer != 'Yes'}}"
                  }
                ]
              },
              "stepType": {
                "name": "Decision"
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "ceb80e4c-e234-5002-8229-bdfe8959aef7",
              "name": "Page On-Call",
              "arguments": {
                "workflowReference": "/api/3/workflows/4cf2d919-9337-513b-b3a1-f77e28d3bb86",
                "arguments": {
                  "records": "{{vars.input.records}}"
                }
              }
            }
          ],
          "routes": [
            {
              "sourceStep": "/api/3/workflow_steps/468e949b-614e-5227-9c35-b31d4e083f94",
              "targetStep": "/api/3/workflow_steps/6659b6ed-7c33-5ce5-abce-39834f3a7538"
            },
            {
              "sourceStep": "/api/3/workflow_steps/6659b6ed-7c33-5ce5-abce-39834f3a7538",
              "targetStep": "/api/3/workflow_steps/43e49140-be13-54ef-9c48-0aed9494fadb"
            },
            {
              "sourceStep": "/api/3/workflow_steps/43e49140-be13-54ef-9c48-0aed9494fadb",
              "targetStep": "/api/3/workflow_steps/eb049cc7-cbc9-5736-ac17-1e33b7a7fb7a"
            },
            {
              "sourceStep": "/api/3/workflow_steps/eb049cc7-cbc9-5736-ac17-1e33b7a7fb7a",
              "targetStep": "/api/3/workflow_steps/ceb80e4c-e234-5002-8229-bdfe8959aef7",
              "label": "Not confirmed"
            }
          ]
        }
      ]
    }
  ]
