        {
          "@type": "Workflow",
          "uuid": "ba67f112-6376-50b6-8919-3d0a71f789c3",
          "name": "AWS - CloudTrail Disabled Response",
          "description": "Restarts CloudTrail logging immediately, finds who stopped it and contains that principal's keys.",
          "isActive": true,
          "recordTags": [
            "AWS",
            "CloudTrail"
          ],
          "triggerStep": "/api/3/workflow_steps/131e0d44-b7b2-5da4-8d9d-868034e1e858",
          "steps": [
            {
              "@type": "WorkflowStep",
              "uuid": "131e0d44-b7b2-5da4-8d9d-868034e1e858",
              "name": "Start",
              "arguments": {
                "resource": "alerts",
                "resources": [
                  "alerts"
                ],
                "fieldbasedtrigger": {
                  "filters": [
                    {
                      "field": "type",
                      "value": "CloudTrail Disabled"
                    }
                  ]
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "9057086d-5ea9-5c85-bb29-02a4217f1936",
              "name": "Check Trail Status",
              "arguments": {
                "connector": "aws-cloudtrail",
