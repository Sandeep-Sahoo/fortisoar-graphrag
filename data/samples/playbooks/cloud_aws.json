        {
          "@type": "Workflow",
          "uuid": "c22ee81e-4232-5bdc-9c23-a5ac741e6a1b",
          "name": "AWS - Disable Access Key",
          "description": "Deactivates a leaked IAM access key after approval, attaches a deny-all policy and emails the key owner.",
          "isActive": true,
          "recordTags": [
            "AWS",
            "IAM",
            "Containment",
            "Subroutine"
          ],
          "triggerStep": "/api/3/workflow_steps/0cf14433-a487-53a4-aa0e-dd31e328c7c9",
          "steps": [
            {
              "@type": "WorkflowStep",
              "uuid": "0cf14433-a487-53a4-aa0e-dd31e328c7c9",
              "name": "Start",
              "arguments": {
                "step_variables": {
                  "input": {
                    "records": "{{vars.input.records}}"
                  }
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "d5d1b6c5-27ec-506f-ab1b-0a678563c956",
              "name": "List Access Keys",
              "arguments": {
                "connector": "aws-iam",
                "operation": "list_access_keys",
                "version": "1.5.0",
                "params": {
                  "user_name": "{{vars.input.records[0].userName}}"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "1dfe1d29-bb1e-59c4-b2ba-217e48fe83fb",
              "name": "Approve Key Disable",
              "arguments": {
                "title": "Deactivate key {{vars.input.records[0].accessKeyId}}?",
                "owner": "Cloud On-Call"
              },
              "stepType": {
                "name": "Manual Input"
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "b1eef6dc-2181-54e3-8d6d-5b754d2ee38d",
              "name": "Deactivate Key",
              "arguments": {
                "connector": "aws-iam",
                "operation": "update_access_key",
                "version": "1.5.0",
                "params": {
                  "access_key_id": "{{vars.input.records[0].accessKeyId}}",
                  "status": "Inactive"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "6e2cc0c3-fdd7-5e09-bf94-969cc1b50b62",
              "name": "Attach Deny-All Policy",
              "arguments": {
                "connector": "aws-iam",
                "operation": "attach_user_policy",
                "version": "1.5.0",
                "params": {
                  "policy_arn": "arn:aws:iam::123456789012:policy/DenyAll"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "26807e0d-8732-51ce-831c-c4615e29d70f",
              "name": "Email Key Owner",
              "arguments": {
                "connector": "smtp",
                "operation": "send_email",
                "version": "2.0.0",
                "params": {
                  "to": "{{vars.input.records[0].ownerEmail}}"
                }
              }
            }
          ],
          "routes": [
            {
              "sourceStep": "/api/3/workflow_steps/0cf14433-a487-53a4-aa0e-dd31e328c7c9",
              "targetStep": "/api/3/workflow_steps/d5d1b6c5-27ec-506f-ab1b-0a678563c956"
            },
            {
              "sourceStep": "/api/3/workflow_steps/d5d1b6c5-27ec-506f-ab1b-0a678563c956",
              "targetStep": "/api/3/workflow_steps/1dfe1d29-bb1e-59c4-b2ba-217e48fe83fb"
            },
            {
              "sourceStep": "/api/3/workflow_steps/1dfe1d29-bb1e-59c4-b2ba-217e48fe83fb",
              "targetStep": "/api/3/workflow_steps/b1eef6dc-2181-54e3-8d6d-5b754d2ee38d"
            },
            {
              "sourceStep": "/api/3/workflow_steps/b1eef6dc-2181-54e3-8d6d-5b754d2ee38d",
              "targetStep": "/api/3/workflow_steps/6e2cc0c3-fdd7-5e09-bf94-969cc1b50b62"
            },
            {
