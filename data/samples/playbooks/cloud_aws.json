              "sourceStep": "/api/3/workflow_steps/a9910f66-8f10-5042-8d3e-b889094ad30d",
              "targetStep": "/api/3/workflow_steps/54ca6a86-8b49-567b-b8af-04334c0e6a00"
            },
            {
              "sourceStep": "/api/3/workflow_steps/54ca6a86-8b49-567b-b8af-04334c0e6a00",
