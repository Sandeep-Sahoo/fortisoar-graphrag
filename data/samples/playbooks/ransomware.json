        {
          "@type": "Workflow",
          "uuid": "ba32a39d-ee8d-5482-b1c5-65b8363008ee",
          "name": "Ransomware - Collect Ransom Note IOCs",
          "description": "Records the ransom note hash and payment/leak-site domains as indicators and blocks the domains.",
          "isActive": true,
          "recordTags": [
            "Ransomware",
            "Threat Intel"
          ],
          "triggerStep": "/api/3/workflow_steps/afaa5693-34dc-53dd-b134-d32114a62895",
          "steps": [
            {
              "@type": "WorkflowStep",
              "uuid": "afaa5693-34dc-53dd-b134-d32114a62895",
              "name": "Start",
              "arguments": {
                "step_variables": {
                  "input": {
                    "records": "{{vars.input.records}}"
                  }
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "c3b41095-caf9-54e7-9cd7-88d029bad25e",
              "name": "Check Note Hash",
              "arguments": {
                "connector": "virustotal",
                "operation": "get_file_reputation",
                "version": "2.5.0",
                "params": {
                  "hash": "{{vars.input.records[0].noteHash}}"
                }
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "79c65941-0343-5696-8aaa-c55d8d6a6296",
              "name": "Create Note Indicators",
              "arguments": {
                "resource": "indicators"
              },
              "stepType": {
                "name": "Create Record"
              }
            },
            {
              "@type": "WorkflowStep",
              "uuid": "27fafc30-b51a-5c5a-b211-9b3509519a12",
              "name": "Block Leak-Site Domains",
              "arguments": {
                "workflowReference": "/api/3/workflows/fd967b56-fd75-5825-8327-50a09166aa40",
                "arguments": {
                  "records": "{{vars.input.records}}"
                }
              }
            }
          ],
          "routes": [
            {
              "sourceStep": "/api/3/workflow_steps/afaa5693-34dc-53dd-b134-d32114a62895",
              "targetStep": "/api/3/workflow_steps/c3b41095-caf9-54e7-9cd7-88d029bad25e"
            },
            {
              "sourceStep": "/api/3/workflow_steps/c3b41095-caf9-54e7-9cd7-88d029bad25e",
              "targetStep": "/api/3/workflow_steps/79c65941-0343-5696-8aaa-c55d8d6a6296"
