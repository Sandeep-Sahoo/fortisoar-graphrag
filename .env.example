# ---- mode: local | cloud | full-local --------------------------------------
APP_MODE=local
COMPOSE_PROFILES=local          # keep equal to APP_MODE
COMPANY_NAME=Marlink

# ---- web UI login -----------------------------------------------------------
# Defaults are admin / admin for local testing; cloud mode refuses to start with them.
APP_USERNAME=admin
APP_PASSWORD=admin
SESSION_HOURS=12

# ---- providers (optional: override the mode preset) ------------------------
# local/cloud default: gemini + gemini embeddings; full-local default: ollama + ollama
# LLM_PROVIDER=gemini           # gemini | anthropic | ollama
# LLM_MODEL=gemini-2.5-flash
# EMBED_PROVIDER=gemini         # gemini | ollama
# EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768                   # changing embed model/dim requires `wipe` + re-ingest
# EMBED_TPM=28000               # embedding tokens/minute pacing (Gemini free tier ~30k); 0 = off for paid keys
# EMBED_CACHE=data/.cache/embeddings.sqlite   # re-runs only embed new/changed text

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Neo4j -----------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687 # cloud: neo4j+s://<id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
# DOCKER_NEO4J_URI=             # only for the app container in cloud mode (Aura URI)

# ---- Ollama (full-local) ---------------------------------------------------
OLLAMA_URL=http://localhost:11434
# On a Mac, native Ollama (Metal GPU) is much faster than the container:
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434

# ---- ingestion -------------------------------------------------------------
FORTISOAR_VERSION=7.6
SCRUB_TERMS=                    # comma-separated tenant/customer/host names to redact
INCLUDE_PROPOSED_LINKS=false    # use unreviewed LLM doc links in answers
